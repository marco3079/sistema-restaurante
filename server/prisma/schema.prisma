// CONTRATO DE DADOS do sistema de restaurante.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

// GESTOR administra tudo. GARCOM atende as mesas, entrega os pedidos e recebe a conta.
// COZINHA inicia o preparo e marca o pedido como pronto.
// LIMPEZA limpa as mesas que ficaram vagas e marca como limpas.
// RECEPCAO vê quais mesas estão livres, ocupadas ou em limpeza e marca a mesa como ocupada ao acomodar o cliente.
enum Perfil {
  GESTOR
  GARCOM
  COZINHA
  LIMPEZA
  RECEPCAO
}

// LIVRE -> OCUPADA (cliente chamou, pediu, ou o garçom marcou) -> LIMPEZA (conta paga ou mesa liberada)
// -> LIVRE (a limpeza marcou como limpa).
enum EstadoMesa {
  LIVRE
  OCUPADA
  LIMPEZA
}

// Caminho de um pedido: NOVO -> EM_PREPARO -> PRONTO -> ENTREGUE. CANCELADO sai do caminho.
enum StatusPedido {
  NOVO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

// CLIENTE: feito pelo cardápio da mesa. GARCOM: lançado pela equipe.
enum OrigemPedido {
  CLIENTE
  GARCOM
}

// Como as maquinetas se ligam aos garçons (o gestor escolhe).
// POR_GARCOM: cada maquineta tem um dono, e o que passa nela conta para ele.
// COMPARTILHADA: qualquer um usa qualquer maquineta, e conta para quem cobrou.
enum VinculoMaquineta {
  POR_GARCOM
  COMPARTILHADA
}

enum OperadoraMaquineta {
  SIMULADA
  MERCADO_PAGO
  STONE
  PAGBANK
  CIELO
  OUTRA
}

// MANUAL: o garçom passa o valor na maquineta e confirma no sistema.
// AUTOMATICA: o sistema manda o valor para a maquineta e recebe o resultado.
enum IntegracaoMaquineta {
  MANUAL
  AUTOMATICA
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
}

enum StatusConta {
  ABERTA
  FECHADA
}

// ENTRADA e SAIDA: lançadas pelo gestor. AJUSTE: acerto de contagem. VENDA e DEVOLUCAO: automáticas, pelos pedidos.
enum TipoMovimento {
  ENTRADA
  SAIDA
  AJUSTE
  VENDA
  DEVOLUCAO
}

enum StatusEspera {
  AGUARDANDO
  CHAMADO
  ACOMODADO
  DESISTIU
}

enum StatusReserva {
  ATIVA
  CHEGOU
  CANCELADA
  NAO_COMPARECEU
}

// Serviço que emite a nota fiscal (o gestor escolhe). WEBHOOK: o sistema envia a venda para um endereço
// do restaurante, o que serve para qualquer emissor.
enum ProvedorFiscal {
  NENHUM
  WEBHOOK
  FOCUS_NFE
  WEBMANIA
}

enum AmbienteFiscal {
  HOMOLOGACAO
  PRODUCAO
}

enum StatusNota {
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  ERRO
}

enum TipoLancamento {
  DESPESA
  RECEITA
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

enum TipoMovimentoCaixa {
  SANGRIA
  REFORCO
}

enum StatusCompra {
  PEDIDA
  RECEBIDA
  CANCELADA
}

enum UnidadeInsumo {
  KG
  G
  L
  ML
  UN
}

// SALAO: mesa de verdade. DELIVERY e RETIRADA: mesa virtual de um pedido para entregar ou retirar no balcão.
enum TipoMesa {
  SALAO
  DELIVERY
  RETIRADA
}

// ---------- Pessoas ----------

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil
  ativo     Boolean  @default(true)
  cpf       String?
  telefone  String?
  foto      String? // endereço http(s) ou data URL (imagem reduzida enviada pelo usuário)
  criadoEm  DateTime @default(now())
  setorId   Int?
  setor     Setor?   @relation(fields: [setorId], references: [id])

  pedidos        Pedido[]
  areas          Area[]          @relation("GarconsDaArea")
  maquinetas     Maquineta[]
  pagamentos     Pagamento[]
  turnos         Turno[]
  pontos         RegistroPonto[]
  inscricoesPush InscricaoPush[]
}

// ---------- Cardápio ----------

model Categoria {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  ordem     Int     @default(0)
  ativa     Boolean @default(true)
  // true = excluída pelo gestor, mas guardada porque há pedidos antigos com produtos dela
  excluida  Boolean @default(false)
  setorId   Int?
  setor     Setor?  @relation(fields: [setorId], references: [id])
  traducoes Json?

  produtos  Produto[]
  promocoes Promocao[]
}

model Produto {
  id          Int       @id @default(autoincrement())
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  nome        String
  descricao   String    @default("")
  preco       Decimal   @db.Decimal(10, 2)
  imagem      String? // data URL reduzida, endereço http(s) ou foto do site (/cardapio/...)

  // Ficha do prato, mostrada no perfil que o cliente abre no cardápio.
  detalhes           String  @default("") // texto de apresentação
  ingredientes       String  @default("") // separados por vírgula ou um por linha
  porcao             String? // ex.: "1 prato (450 g)", "Serve 2 pessoas"
  tempoPreparoMin    Int?
  alergenicos        String? // ex.: "Glúten, leite"
  // Tabela nutricional da porção inteira. Nulo = não informado.
  kcal               Float?
  carboidratosG      Float?
  proteinasG         Float?
  gordurasG          Float?
  gordurasSaturadasG Float?
  fibrasG            Float?
  sodioMg            Float?

  disponivel  Boolean @default(true) // false = esgotado (some do cardápio do cliente)
  ativo       Boolean @default(true) // false = removido do cardápio (o histórico continua)
  recomendado Boolean @default(false) // aparece na área "Recomendados" do cardápio do cliente

  // Estoque: com o controle ligado, cada pedido baixa o saldo e o item esgota sozinho ao zerar.
  controlaEstoque Boolean @default(false)
  estoque         Int     @default(0)
  estoqueMinimo   Int     @default(0) // abaixo ou igual a isto, o gestor é avisado

  // Dados fiscais do item (vazio = usa o padrão das configurações fiscais).
  ncm      String?
  cfop     String?
  criadoEm DateTime @default(now())

  // Combo: um produto com combo = true; os produtos que vêm nele estão em comboItens.
  combo     Boolean @default(false)
  traducoes Json?

  itens       ItemPedido[]
  movimentos  MovimentoEstoque[]
  fichaItens  FichaItem[]
  compraItens CompraItem[]
  grupos      GrupoOpcao[]
  promocoes   Promocao[]
  comboItens  ComboItem[]        @relation("ItensDoCombo")
  emCombos    ComboItem[]        @relation("ProdutoEmCombos")

  @@index([categoriaId])
}

// ---------- Salão ----------

model Mesa {
  id            Int        @id @default(autoincrement())
  numero        Int        @unique
  nome          String? // ex.: "Varanda"
  lugares       Int        @default(4)
  codigo        String     @unique // segredo do endereço do cardápio da mesa (QR code)
  ativa         Boolean    @default(true)
  chamandoDesde DateTime? // cliente pediu o garçom; null = sem chamado
  estado        EstadoMesa @default(LIVRE)
  estadoDesde   DateTime   @default(now()) // quando entrou no estado atual
  areaId        Int? // área do salão; os garçons da área respondem pela mesa
  area          Area?      @relation(fields: [areaId], references: [id])
  posX          Float? // centro da mesa na planta, de 0 a 1 (fração da largura); null = fora da planta
  posY          Float?
  criadaEm      DateTime   @default(now())
  tipo          TipoMesa   @default(SALAO)

  pedidos    Pedido[]
  pagamentos Pagamento[]
  contas     Conta[]
  reservas   Reserva[]

  @@index([tipo, ativa])
}

// Área do salão (ex.: Varanda, Salão principal). Pode ter mais de um garçom responsável.
model Area {
  id      Int    @id @default(autoincrement())
  nome    String @unique
  cor     String @default("#2563eb")
  // Retângulo da área na planta, em frações de 0 a 1. Nulo = área sem desenho.
  x       Float?
  y       Float?
  largura Float?
  altura  Float?

  mesas   Mesa[]
  garcons Usuario[] @relation("GarconsDaArea")
}

// Planta do restaurante: imagem enviada pelo gestor (linha única, id = 1).
model Planta {
  id           Int      @id @default(1)
  imagem       String // data URL (jpeg, png ou webp), já reduzida pela tela
  largura      Int
  altura       Int
  atualizadaEm DateTime @updatedAt
}

// ---------- Pedidos ----------

// A conta de uma mesa é o conjunto de pedidos dela ainda não pagos (pagoEm nulo) e não cancelados.
model Pedido {
  id                Int          @id @default(autoincrement())
  mesaId            Int
  mesa              Mesa         @relation(fields: [mesaId], references: [id])
  status            StatusPedido @default(NOVO)
  origem            OrigemPedido
  nomeCliente       String?
  observacao        String?
  garcomId          Int? // quem lançou (origem GARCOM) ou quem assumiu o pedido
  garcom            Usuario?     @relation(fields: [garcomId], references: [id])
  total             Decimal      @db.Decimal(10, 2)
  pagoEm            DateTime?
  formaPagamento    String?
  contaId           Int? // conta da mesa em que este pedido entrou
  conta             Conta?       @relation(fields: [contaId], references: [id])
  criadoEm          DateTime     @default(now())
  atualizadoEm      DateTime     @updatedAt
  preparoIniciadoEm DateTime? // quando a cozinha iniciou o preparo
  prontoEm          DateTime? // quando ficou pronto
  entregueEm        DateTime? // quando foi entregue

  itens   ItemPedido[]
  setores PedidoSetor[]
  entrega Entrega?

  @@index([mesaId, pagoEm])
  @@index([status, criadoEm])
  @@index([criadoEm])
}

model ItemPedido {
  id            Int      @id @default(autoincrement())
  pedidoId      Int
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     Int
  produto       Produto  @relation(fields: [produtoId], references: [id])
  nomeProduto   String // cópia do nome no momento do pedido
  precoUnitario Decimal  @db.Decimal(10, 2) // cópia do preço no momento do pedido
  quantidade    Int
  observacao    String?
  opcoes        Json? // lista [{ grupo, opcao, precoExtra }]
  precoOriginal Decimal? @db.Decimal(10, 2) // preço de tabela quando havia promoção
  setorId       Int?

  @@index([pedidoId])
}

// ---------- Conta da mesa ----------

// Abre com o primeiro pedido e fecha quando os pagamentos aprovados cobrem o total
// (pedidos + taxa de serviço). Pode ser paga em partes.
model Conta {
  id             Int         @id @default(autoincrement())
  mesaId         Int
  mesa           Mesa        @relation(fields: [mesaId], references: [id])
  status         StatusConta @default(ABERTA)
  taxaServico    Boolean     @default(true) // o garçom desliga se o cliente não quiser pagar
  taxaPercentual Decimal     @db.Decimal(5, 2) // percentual da taxa quando a conta abriu
  cpfCnpjCliente String? // para a nota fiscal
  abertaEm       DateTime    @default(now())
  fechadaEm      DateTime?
  cupomId        Int?
  cupom          Cupom?      @relation(fields: [cupomId], references: [id])
  clienteId      Int?
  cliente        Cliente?    @relation(fields: [clienteId], references: [id])
  pontosUsados   Int         @default(0)
  valorDoPonto   Decimal     @default(0) @db.Decimal(8, 4)
  descontoManual Decimal     @default(0) @db.Decimal(10, 2)
  descontoMotivo String?
  taxaEntrega    Decimal     @default(0) @db.Decimal(10, 2)

  pedidos    Pedido[]
  pagamentos Pagamento[]
  nota       NotaFiscal?
  avaliacao  Avaliacao?

  @@index([mesaId, status])
}

// ---------- Pagamentos ----------

model Maquineta {
  id            Int                 @id @default(autoincrement())
  nome          String // ex.: "Maquineta da Ana", "Caixa"
  operadora     OperadoraMaquineta
  integracao    IntegracaoMaquineta @default(MANUAL)
  identificador String? // número de série ou id do terminal na operadora
  garcomId      Int? // dono da maquineta (modo POR_GARCOM); null = sem dono
  garcom        Usuario?            @relation(fields: [garcomId], references: [id])
  ativa         Boolean             @default(true)
  criadaEm      DateTime            @default(now())

  pagamentos Pagamento[]
}

// Uma cobrança da conta de uma mesa. Aprovada, marca os pedidos dela como pagos.
model Pagamento {
  id                Int             @id @default(autoincrement())
  mesaId            Int
  mesa              Mesa            @relation(fields: [mesaId], references: [id])
  contaId           Int?
  conta             Conta?          @relation(fields: [contaId], references: [id])
  valor             Decimal         @db.Decimal(10, 2) // parte da conta que este pagamento quita
  gorjeta           Decimal         @default(0) @db.Decimal(10, 2) // dada além da conta
  valorServico      Decimal         @default(0) @db.Decimal(10, 2) // quanto do valor é taxa de serviço
  pix               String? // Pix copia e cola desta cobrança
  formaPagamento    String // Dinheiro, Pix, Cartão de débito, Cartão de crédito
  status            StatusPagamento @default(PENDENTE)
  maquinetaId       Int? // null = recebido sem maquineta (dinheiro, por exemplo)
  maquineta         Maquineta?      @relation(fields: [maquinetaId], references: [id])
  garcomId          Int // quem leva o crédito do recebimento (desempenho)
  garcom            Usuario         @relation(fields: [garcomId], references: [id])
  iniciadoPorId     Int // quem apertou "cobrar"
  referenciaExterna String? // número da cobrança na operadora (integração automática)
  codigoAutorizacao String? // código do comprovante
  mensagem          String? // situação para mostrar na tela
  criadoEm          DateTime        @default(now())
  concluidoEm       DateTime?

  @@index([garcomId, concluidoEm])
  @@index([contaId])
  @@index([mesaId, status])
}

// ---------- Estoque ----------

model MovimentoEstoque {
  id          Int           @id @default(autoincrement())
  produtoId   Int
  produto     Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tipo        TipoMovimento
  quantidade  Int // positivo entra, negativo sai
  saldo       Int // saldo depois do movimento
  motivo      String?
  usuarioNome String?
  criadoEm    DateTime      @default(now())

  @@index([produtoId, criadoEm])
}

// ---------- Recepção: fila de espera e reservas ----------

model Espera {
  id          Int          @id @default(autoincrement())
  nome        String
  pessoas     Int
  telefone    String?
  observacao  String?
  status      StatusEspera @default(AGUARDANDO)
  mesaId      Int? // mesa em que foi acomodado
  criadoEm    DateTime     @default(now())
  chamadoEm   DateTime?
  encerradoEm DateTime?

  @@index([status, criadoEm])
}

model Reserva {
  id         Int           @id @default(autoincrement())
  nome       String
  pessoas    Int
  telefone   String?
  dataHora   DateTime
  mesaId     Int?
  mesa       Mesa?         @relation(fields: [mesaId], references: [id])
  observacao String?
  status     StatusReserva @default(ATIVA)
  criadoEm   DateTime      @default(now())

  @@index([dataHora])
}

// ---------- Nota fiscal ----------

// Uma nota por conta fechada, emitida pelo serviço que o gestor conectou.
model NotaFiscal {
  id             Int            @id @default(autoincrement())
  contaId        Int            @unique
  conta          Conta          @relation(fields: [contaId], references: [id])
  provedor       ProvedorFiscal
  ambiente       AmbienteFiscal
  referencia     String         @unique // identificação da nota no emissor
  status         StatusNota
  numero         String?
  serie          String?
  chave          String?
  urlDanfe       String?
  urlXml         String?
  mensagem       String?
  cpfCnpjCliente String?
  valor          Decimal        @db.Decimal(10, 2)
  criadaEm       DateTime       @default(now())
  atualizadaEm   DateTime       @updatedAt

  @@index([criadaEm])
}

// ---------- Financeiro: ganhos e gastos ----------

model CategoriaFinanceira {
  id    Int            @id @default(autoincrement())
  nome  String
  tipo  TipoLancamento
  cor   String         @default("#64748b")
  ativa Boolean        @default(true)

  lancamentos Lancamento[]

  @@unique([nome, tipo])
}

// Despesa ou receita lançada pelo gestor. As vendas das mesas NÃO ficam aqui: vêm dos pagamentos.
model Lancamento {
  id             Int                 @id @default(autoincrement())
  tipo           TipoLancamento
  categoriaId    Int
  categoria      CategoriaFinanceira @relation(fields: [categoriaId], references: [id])
  descricao      String
  valor          Decimal             @db.Decimal(12, 2)
  data           DateTime // dia do lançamento (meio-dia no fuso do servidor)
  pago           Boolean             @default(true)
  pagoEm         DateTime?
  vencimento     DateTime?
  formaPagamento String?
  fornecedorId   Int?
  fornecedor     Fornecedor?         @relation(fields: [fornecedorId], references: [id])
  compraId       Int?                @unique // lançamento gerado por uma compra recebida
  compra         Compra?             @relation(fields: [compraId], references: [id])
  observacao     String?
  criadoPorNome  String?
  criadoEm       DateTime            @default(now())

  @@index([data])
  @@index([tipo, pago])
}

// ---------- Caixa ----------

model Caixa {
  id             Int         @id @default(autoincrement())
  status         StatusCaixa @default(ABERTO)
  abertoPorId    Int
  abertoPorNome  String
  abertoEm       DateTime    @default(now())
  valorInicial   Decimal     @db.Decimal(10, 2)
  fechadoPorNome String?
  fechadoEm      DateTime?
  valorContado   Decimal?    @db.Decimal(10, 2)
  valorEsperado  Decimal?    @db.Decimal(10, 2)
  diferenca      Decimal?    @db.Decimal(10, 2)
  observacao     String?

  movimentos MovimentoCaixa[]

  @@index([status])
}

model MovimentoCaixa {
  id          Int                @id @default(autoincrement())
  caixaId     Int
  caixa       Caixa              @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  tipo        TipoMovimentoCaixa
  valor       Decimal            @db.Decimal(10, 2)
  motivo      String?
  usuarioNome String
  criadoEm    DateTime           @default(now())

  @@index([caixaId])
}

// ---------- Insumos e ficha técnica ----------

model Insumo {
  id            Int           @id @default(autoincrement())
  nome          String        @unique
  unidade       UnidadeInsumo
  estoque       Decimal       @default(0) @db.Decimal(12, 3)
  estoqueMinimo Decimal       @default(0) @db.Decimal(12, 3)
  custoUnitario Decimal       @default(0) @db.Decimal(10, 4) // custo médio por unidade
  ativo         Boolean       @default(true)
  criadoEm      DateTime      @default(now())

  fichas      FichaItem[]
  movimentos  MovimentoInsumo[]
  compraItens CompraItem[]
}

// Quanto de cada insumo vai em uma unidade do produto.
model FichaItem {
  id         Int     @id @default(autoincrement())
  produtoId  Int
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  insumoId   Int
  insumo     Insumo  @relation(fields: [insumoId], references: [id])
  quantidade Decimal @db.Decimal(12, 3)

  @@unique([produtoId, insumoId])
}

model MovimentoInsumo {
  id          Int           @id @default(autoincrement())
  insumoId    Int
  insumo      Insumo        @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  tipo        TipoMovimento
  quantidade  Decimal       @db.Decimal(12, 3) // positivo entra, negativo sai
  saldo       Decimal       @db.Decimal(12, 3)
  motivo      String?
  usuarioNome String?
  criadoEm    DateTime      @default(now())

  @@index([insumoId, criadoEm])
}

// ---------- Fornecedores e compras ----------

model Fornecedor {
  id         Int      @id @default(autoincrement())
  nome       String
  cnpjCpf    String?
  telefone   String?
  email      String?
  contato    String?
  observacao String?
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())

  compras     Compra[]
  lancamentos Lancamento[]
}

model Compra {
  id            Int          @id @default(autoincrement())
  fornecedorId  Int
  fornecedor    Fornecedor   @relation(fields: [fornecedorId], references: [id])
  status        StatusCompra @default(PEDIDA)
  observacao    String?
  total         Decimal      @db.Decimal(12, 2)
  pedidaEm      DateTime     @default(now())
  recebidaEm    DateTime?
  criadaPorNome String?

  itens      CompraItem[]
  lancamento Lancamento?

  @@index([status, pedidaEm])
}

// Item da compra: um produto com estoque, um insumo, ou só uma descrição livre.
model CompraItem {
  id            Int      @id @default(autoincrement())
  compraId      Int
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produtoId     Int?
  produto       Produto? @relation(fields: [produtoId], references: [id])
  insumoId      Int?
  insumo        Insumo?  @relation(fields: [insumoId], references: [id])
  descricao     String
  quantidade    Decimal  @db.Decimal(12, 3)
  custoUnitario Decimal  @db.Decimal(10, 4)

  @@index([compraId])
}

// ---------- Escala e ponto ----------

model Turno {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  data       DateTime @db.Date
  inicio     String // "18:00"
  fim        String // "23:30"
  observacao String?

  @@index([data])
  @@index([usuarioId, data])
}

model RegistroPonto {
  id              Int       @id @default(autoincrement())
  usuarioId       Int
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  entrada         DateTime
  saida           DateTime?
  observacao      String?
  ajustadoPorNome String? // preenchido quando o gestor criou ou corrigiu o registro

  @@index([usuarioId, entrada])
  @@index([entrada])
}

// ---------- Rateio da taxa de serviço ----------

// Regra do rateio (linha única, id = 1). Os percentuais somam 100.
model RegraRateio {
  id                      Int     @id @default(1)
  percGarcom              Decimal @default(70) @db.Decimal(5, 2)
  percCozinha             Decimal @default(20) @db.Decimal(5, 2)
  percLimpeza             Decimal @default(5) @db.Decimal(5, 2)
  percRecepcao            Decimal @default(5) @db.Decimal(5, 2)
  percCasa                Decimal @default(0) @db.Decimal(5, 2)
  divisaoInterna          String  @default("IGUAL") // IGUAL ou HORAS (pelas horas do ponto)
  gorjetasParaQuemRecebeu Boolean @default(true) // false = as gorjetas entram no bolo do rateio
}

// Rateio fechado de um período, guardado como foi calculado.
model Repasse {
  id            Int      @id @default(autoincrement())
  de            DateTime
  ate           DateTime
  totalTaxa     Decimal  @db.Decimal(12, 2)
  totalGorjetas Decimal  @db.Decimal(12, 2)
  itens         Json
  criadoPorNome String?
  criadoEm      DateTime @default(now())

  @@index([criadoEm])
}

// ---------- Adicionais e opções do prato ----------

model GrupoOpcao {
  id        Int     @id @default(autoincrement())
  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nome      String // ex.: "Ponto da carne", "Adicionais"
  minimo    Int     @default(0) // quantas opções o cliente precisa escolher
  maximo    Int     @default(1) // quantas pode escolher
  ordem     Int     @default(0)

  opcoes Opcao[]

  @@index([produtoId])
}

model Opcao {
  id         Int        @id @default(autoincrement())
  grupoId    Int
  grupo      GrupoOpcao @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nome       String
  precoExtra Decimal    @default(0) @db.Decimal(10, 2)
  ativa      Boolean    @default(true)
  ordem      Int        @default(0)

  @@index([grupoId])
}

// ---------- Promoções, combos e cupons ----------

// Preço promocional por horário. Sem produto e sem categoria = vale para o cardápio todo.
model Promocao {
  id          Int        @id @default(autoincrement())
  nome        String
  produtoId   Int?
  produto     Produto?   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  categoriaId Int?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  percentual  Decimal?   @db.Decimal(5, 2) // desconto em %
  precoFixo   Decimal?   @db.Decimal(10, 2) // ou preço final (só com produto)
  diasSemana  Int[] // 0 = domingo .. 6 = sábado; vazio = todos os dias
  horaInicio  String     @default("00:00")
  horaFim     String     @default("23:59")
  dataInicio  DateTime?
  dataFim     DateTime?
  ativa       Boolean    @default(true)
  criadaEm    DateTime   @default(now())
}

// Um combo é um Produto com combo = true; estes são os produtos que vêm nele.
model ComboItem {
  id         Int     @id @default(autoincrement())
  comboId    Int
  combo      Produto @relation("ItensDoCombo", fields: [comboId], references: [id], onDelete: Cascade)
  produtoId  Int
  produto    Produto @relation("ProdutoEmCombos", fields: [produtoId], references: [id])
  quantidade Int     @default(1)

  @@unique([comboId, produtoId])
}

model Cupom {
  id         Int       @id @default(autoincrement())
  codigo     String    @unique // sempre em maiúsculas
  descricao  String?
  percentual Decimal?  @db.Decimal(5, 2)
  valor      Decimal?  @db.Decimal(10, 2)
  minimo     Decimal   @default(0) @db.Decimal(10, 2) // consumo mínimo para valer
  validade   DateTime?
  limiteUsos Int?
  usos       Int       @default(0)
  ativo      Boolean   @default(true)
  criadoEm   DateTime  @default(now())

  contas Conta[]
}

// ---------- Clientes e fidelidade ----------

model Cliente {
  id         Int       @id @default(autoincrement())
  nome       String
  telefone   String    @unique // só dígitos
  email      String?
  nascimento DateTime? @db.Date
  pontos     Int       @default(0)
  observacao String?
  criadoEm   DateTime  @default(now())

  contas     Conta[]
  movimentos MovimentoPontos[]
}

model MovimentoPontos {
  id        Int      @id @default(autoincrement())
  clienteId Int
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  contaId   Int?
  pontos    Int // positivo ganha, negativo usa
  motivo    String
  criadoEm  DateTime @default(now())

  @@index([clienteId, criadoEm])
}

// ---------- Avaliação do cliente ----------

model Avaliacao {
  id              Int      @id @default(autoincrement())
  contaId         Int      @unique
  conta           Conta    @relation(fields: [contaId], references: [id])
  mesaId          Int
  garcomId        Int? // quem recebeu a conta
  notaComida      Int // 1 a 5
  notaAtendimento Int // 1 a 5
  comentario      String?
  criadoEm        DateTime @default(now())

  @@index([criadoEm])
  @@index([garcomId])
}

// ---------- Setores de preparo (cozinha, bar, sobremesas) ----------

model Setor {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  cor   String  @default("#2563eb")
  ativo Boolean @default(true)
  ordem Int     @default(0)

  categorias Categoria[]
  usuarios   Usuario[]
  pedidos    PedidoSetor[]
}

// A parte de um pedido que cabe a um setor, com a situação dessa parte.
model PedidoSetor {
  id           Int          @id @default(autoincrement())
  pedidoId     Int
  pedido       Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  setorId      Int
  setor        Setor        @relation(fields: [setorId], references: [id], onDelete: Cascade)
  status       StatusPedido @default(NOVO)
  atualizadoEm DateTime     @updatedAt

  @@unique([pedidoId, setorId])
}

// ---------- Delivery e retirada ----------

model BairroEntrega {
  id    Int     @id @default(autoincrement())
  nome  String  @unique
  taxa  Decimal @db.Decimal(10, 2)
  ativo Boolean @default(true)
}

// Dados de entrega (ou retirada) de um pedido feito pelo cardápio de delivery.
model Entrega {
  id             Int       @id @default(autoincrement())
  pedidoId       Int       @unique
  pedido         Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo           TipoMesa // DELIVERY ou RETIRADA
  codigo         String    @unique // segredo do endereço de acompanhamento
  nomeCliente    String
  telefone       String // só dígitos
  endereco       String? // rua e número
  complemento    String?
  bairro         String? // nome do bairro no momento do pedido
  referencia     String?
  taxaEntrega    Decimal   @default(0) @db.Decimal(10, 2)
  formaPagamento String // como o cliente vai pagar na entrega ou na retirada
  trocoPara      Decimal?  @db.Decimal(10, 2)
  saiuEm         DateTime? // saiu para entrega
  concluidoEm    DateTime? // entregue ou retirado
  entregadorNome String?
  criadoEm       DateTime  @default(now())

  @@index([criadoEm])
}

// ---------- Notificações no celular ----------

model InscricaoPush {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

// ---------- Log de atividades ----------

// Um registro por atividade na plataforma. Visível só para o GESTOR.
// Não guarda corpo de requisição nem senha. Registros com mais de 90 dias são apagados.
model LogAtividade {
  id          Int      @id @default(autoincrement())
  criadoEm    DateTime @default(now())
  usuarioId   Int? // sem relação: o log sobrevive à exclusão do usuário
  usuarioNome String?
  perfil      String? // perfil no momento: GESTOR, GARCOM, COZINHA, LIMPEZA ou RECEPCAO
  tipo        String // LOGIN, FALHA_LOGIN, SAIDA, TELA, CONSULTA, CRIACAO, ALTERACAO, EXCLUSAO
  modulo      String // ex.: pedidos, mesas, cardapio, sessao
  descricao   String // frase curta em português
  metodo      String? // GET, POST, PUT, DELETE
  caminho     String? // caminho da API ou da tela, sem query string
  status      Int? // código HTTP da resposta
  duracaoMs   Int?
  ip          String?
  navegador   String?

  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
  @@index([tipo, criadoEm])
}

// ===== Configurações da plataforma (linha única, id = 1) =====

model ConfiguracaoPlataforma {
  id            Int     @id @default(1)
  nome          String  @default("Sistema de Restaurante")
  slogan        String  @default("Sabor e atendimento em cada mesa.")
  logo          String? // data URL (jpeg, png ou webp) ou endereço http(s); null = logo padrão
  corPrimaria   String  @default("#2563eb")
  corSecundaria String  @default("#1d4ed8")
  enderecoSite  String? // endereço público do site, usado nos links dos e-mails e nos QR codes

  smtpServidor       String?
  smtpPorta          Int     @default(587)
  smtpSeguro         Boolean @default(false) // true = TLS direto (porta 465)
  smtpUsuario        String?
  smtpSenhaCifrada   String? // AES-256-GCM; nunca sai pela API
  emailRemetente     String?
  emailNomeRemetente String?
  emailAtivo         Boolean @default(false)

  emailRecuperacao Boolean @default(true)
  emailBoasVindas  Boolean @default(true)

  vinculoMaquineta        VinculoMaquineta @default(COMPARTILHADA)
  mercadoPagoTokenCifrado String? // AES-256-GCM; nunca sai pela API

  // Taxa de serviço das contas novas (0 = sem taxa) e Pix do restaurante.
  taxaServicoPercentual Decimal @default(10) @db.Decimal(5, 2)
  pixChave              String?
  pixNome               String? // nome de quem recebe, como aparece no aplicativo do banco
  pixCidade             String?

  // Fidelidade: pontos ganhos por real pago e valor de cada ponto na conta.
  fidelidadeAtiva Boolean  @default(false)
  pontosPorReal   Decimal  @default(1) @db.Decimal(6, 2)
  valorDoPonto    Decimal  @default(0.05) @db.Decimal(8, 4)
  // Idiomas do cardápio além do português.
  idiomas         String[] @default(["pt"])

  // Nota fiscal.
  fiscalProvedor            ProvedorFiscal @default(NENHUM)
  fiscalAmbiente            AmbienteFiscal @default(HOMOLOGACAO)
  fiscalCredenciaisCifradas String? // JSON com as credenciais do emissor, AES-256-GCM; nunca sai pela API
  fiscalWebhookUrl          String?
  fiscalCnpj                String?
  fiscalEmissaoAutomatica   Boolean        @default(false) // emite ao fechar a conta
  fiscalNcmPadrao           String         @default("21069090")
  fiscalCfopPadrao          String         @default("5102")
  fiscalCsosnPadrao         String         @default("102")
  fiscalClasseImposto       String? // referência da classe de imposto (WebmaniaBR)

  // Delivery e retirada no balcão.
  deliveryAtivo        Boolean @default(false)
  retiradaAtiva        Boolean @default(false)
  deliveryPedidoMinimo Decimal @default(0) @db.Decimal(10, 2)
  deliveryTempoMin     Int     @default(50) // tempo estimado de entrega, em minutos
  retiradaTempoMin     Int     @default(25)
  deliveryAviso        String? // recado no topo do cardápio de delivery (ex.: horário de atendimento)

  // Pedido parado além deste tempo (minutos) aparece como atrasado. 0 = sem alerta.
  alertaAtrasoMin Int @default(20)

  // Ações sensíveis: senha do gestor (só o hash) e o que cada ação exige de quem não é gestor.
  pinHash     String?
  regrasAcoes Json?

  // Notificações no celular (Web Push). A chave privada fica cifrada.
  vapidPublica        String?
  vapidPrivadaCifrada String?

  atualizadoEm DateTime @updatedAt
}

enum TipoTokenSenha {
  RECUPERACAO
  BOAS_VINDAS
}

// Token de uso único para criar ou redefinir a senha por e-mail (só o hash fica no banco).
model TokenSenha {
  id        Int            @id @default(autoincrement())
  usuarioId Int
  tokenHash String         @unique
  tipo      TipoTokenSenha
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime       @default(now())

  @@index([usuarioId])
}

enum StatusEmail {
  ENVIADO
  FALHOU
}

// Histórico dos e-mails enviados (sem o corpo), para o gestor conferir.
model EmailEnviado {
  id       Int         @id @default(autoincrement())
  para     String
  assunto  String
  tipo     String // TESTE, RECUPERACAO, BOAS_VINDAS
  status   StatusEmail
  erro     String?
  criadoEm DateTime    @default(now())

  @@index([criadoEm])
}
