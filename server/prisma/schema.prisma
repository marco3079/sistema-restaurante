// CONTRATO DE DADOS do sistema de restaurante.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

// GESTOR administra tudo. GARCOM atende as mesas, entrega os pedidos e recebe a conta.
// COZINHA inicia o preparo e marca o pedido como pronto.
// LIMPEZA limpa as mesas que ficaram vagas e marca como limpas.
// RECEPCAO vê quais mesas estão livres, ocupadas ou em limpeza e marca a mesa como ocupada ao acomodar o cliente.
enum Perfil {
  GESTOR
  GARCOM
  COZINHA
  LIMPEZA
  RECEPCAO
}

// LIVRE -> OCUPADA (cliente chamou, pediu, ou o garçom marcou) -> LIMPEZA (conta paga ou mesa liberada)
// -> LIVRE (a limpeza marcou como limpa).
enum EstadoMesa {
  LIVRE
  OCUPADA
  LIMPEZA
}

// Caminho de um pedido: NOVO -> EM_PREPARO -> PRONTO -> ENTREGUE. CANCELADO sai do caminho.
enum StatusPedido {
  NOVO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

// CLIENTE: feito pelo cardápio da mesa. GARCOM: lançado pela equipe.
enum OrigemPedido {
  CLIENTE
  GARCOM
}

// Como as maquinetas se ligam aos garçons (o gestor escolhe).
// POR_GARCOM: cada maquineta tem um dono, e o que passa nela conta para ele.
// COMPARTILHADA: qualquer um usa qualquer maquineta, e conta para quem cobrou.
enum VinculoMaquineta {
  POR_GARCOM
  COMPARTILHADA
}

enum OperadoraMaquineta {
  SIMULADA
  MERCADO_PAGO
  STONE
  PAGBANK
  CIELO
  OUTRA
}

// MANUAL: o garçom passa o valor na maquineta e confirma no sistema.
// AUTOMATICA: o sistema manda o valor para a maquineta e recebe o resultado.
enum IntegracaoMaquineta {
  MANUAL
  AUTOMATICA
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
}

enum StatusConta {
  ABERTA
  FECHADA
}

// ENTRADA e SAIDA: lançadas pelo gestor. AJUSTE: acerto de contagem. VENDA e DEVOLUCAO: automáticas, pelos pedidos.
enum TipoMovimento {
  ENTRADA
  SAIDA
  AJUSTE
  VENDA
  DEVOLUCAO
}

enum StatusEspera {
  AGUARDANDO
  CHAMADO
  ACOMODADO
  DESISTIU
}

enum StatusReserva {
  ATIVA
  CHEGOU
  CANCELADA
  NAO_COMPARECEU
}

// Serviço que emite a nota fiscal (o gestor escolhe). WEBHOOK: o sistema envia a venda para um endereço
// do restaurante, o que serve para qualquer emissor.
enum ProvedorFiscal {
  NENHUM
  WEBHOOK
  FOCUS_NFE
  WEBMANIA
}

enum AmbienteFiscal {
  HOMOLOGACAO
  PRODUCAO
}

enum StatusNota {
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  ERRO
}

// ---------- Pessoas ----------

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil
  ativo     Boolean  @default(true)
  cpf       String?
  telefone  String?
  foto      String? // endereço http(s) ou data URL (imagem reduzida enviada pelo usuário)
  criadoEm  DateTime @default(now())

  pedidos    Pedido[]
  areas      Area[]      @relation("GarconsDaArea")
  maquinetas Maquineta[]
  pagamentos Pagamento[]
}

// ---------- Cardápio ----------

model Categoria {
  id       Int     @id @default(autoincrement())
  nome     String  @unique
  ordem    Int     @default(0)
  ativa    Boolean @default(true)
  // true = excluída pelo gestor, mas guardada porque há pedidos antigos com produtos dela
  excluida Boolean @default(false)

  produtos Produto[]
}

model Produto {
  id          Int       @id @default(autoincrement())
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  nome        String
  descricao   String    @default("")
  preco       Decimal   @db.Decimal(10, 2)
  imagem      String? // data URL reduzida, endereço http(s) ou foto do site (/cardapio/...)

  // Ficha do prato, mostrada no perfil que o cliente abre no cardápio.
  detalhes           String  @default("") // texto de apresentação
  ingredientes       String  @default("") // separados por vírgula ou um por linha
  porcao             String? // ex.: "1 prato (450 g)", "Serve 2 pessoas"
  tempoPreparoMin    Int?
  alergenicos        String? // ex.: "Glúten, leite"
  // Tabela nutricional da porção inteira. Nulo = não informado.
  kcal               Float?
  carboidratosG      Float?
  proteinasG         Float?
  gordurasG          Float?
  gordurasSaturadasG Float?
  fibrasG            Float?
  sodioMg            Float?

  disponivel  Boolean @default(true) // false = esgotado (some do cardápio do cliente)
  ativo       Boolean @default(true) // false = removido do cardápio (o histórico continua)
  recomendado Boolean @default(false) // aparece na área "Recomendados" do cardápio do cliente

  // Estoque: com o controle ligado, cada pedido baixa o saldo e o item esgota sozinho ao zerar.
  controlaEstoque Boolean @default(false)
  estoque         Int     @default(0)
  estoqueMinimo   Int     @default(0) // abaixo ou igual a isto, o gestor é avisado

  // Dados fiscais do item (vazio = usa o padrão das configurações fiscais).
  ncm      String?
  cfop     String?
  criadoEm DateTime @default(now())

  itens      ItemPedido[]
  movimentos MovimentoEstoque[]

  @@index([categoriaId])
}

// ---------- Salão ----------

model Mesa {
  id            Int        @id @default(autoincrement())
  numero        Int        @unique
  nome          String? // ex.: "Varanda"
  lugares       Int        @default(4)
  codigo        String     @unique // segredo do endereço do cardápio da mesa (QR code)
  ativa         Boolean    @default(true)
  chamandoDesde DateTime? // cliente pediu o garçom; null = sem chamado
  estado        EstadoMesa @default(LIVRE)
  estadoDesde   DateTime   @default(now()) // quando entrou no estado atual
  areaId        Int? // área do salão; os garçons da área respondem pela mesa
  area          Area?      @relation(fields: [areaId], references: [id])
  posX          Float? // centro da mesa na planta, de 0 a 1 (fração da largura); null = fora da planta
  posY          Float?
  criadaEm      DateTime   @default(now())

  pedidos    Pedido[]
  pagamentos Pagamento[]
  contas     Conta[]
  reservas   Reserva[]
}

// Área do salão (ex.: Varanda, Salão principal). Pode ter mais de um garçom responsável.
model Area {
  id      Int    @id @default(autoincrement())
  nome    String @unique
  cor     String @default("#2563eb")
  // Retângulo da área na planta, em frações de 0 a 1. Nulo = área sem desenho.
  x       Float?
  y       Float?
  largura Float?
  altura  Float?

  mesas   Mesa[]
  garcons Usuario[] @relation("GarconsDaArea")
}

// Planta do restaurante: imagem enviada pelo gestor (linha única, id = 1).
model Planta {
  id           Int      @id @default(1)
  imagem       String // data URL (jpeg, png ou webp), já reduzida pela tela
  largura      Int
  altura       Int
  atualizadaEm DateTime @updatedAt
}

// ---------- Pedidos ----------

// A conta de uma mesa é o conjunto de pedidos dela ainda não pagos (pagoEm nulo) e não cancelados.
model Pedido {
  id             Int          @id @default(autoincrement())
  mesaId         Int
  mesa           Mesa         @relation(fields: [mesaId], references: [id])
  status         StatusPedido @default(NOVO)
  origem         OrigemPedido
  nomeCliente    String?
  observacao     String?
  garcomId       Int? // quem lançou (origem GARCOM) ou quem assumiu o pedido
  garcom         Usuario?     @relation(fields: [garcomId], references: [id])
  total          Decimal      @db.Decimal(10, 2)
  pagoEm         DateTime?
  formaPagamento String?
  contaId        Int? // conta da mesa em que este pedido entrou
  conta          Conta?       @relation(fields: [contaId], references: [id])
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt

  itens ItemPedido[]

  @@index([mesaId, pagoEm])
  @@index([status, criadoEm])
  @@index([criadoEm])
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     Int
  produto       Produto @relation(fields: [produtoId], references: [id])
  nomeProduto   String // cópia do nome no momento do pedido
  precoUnitario Decimal @db.Decimal(10, 2) // cópia do preço no momento do pedido
  quantidade    Int
  observacao    String?

  @@index([pedidoId])
}

// ---------- Conta da mesa ----------

// Abre com o primeiro pedido e fecha quando os pagamentos aprovados cobrem o total
// (pedidos + taxa de serviço). Pode ser paga em partes.
model Conta {
  id             Int         @id @default(autoincrement())
  mesaId         Int
  mesa           Mesa        @relation(fields: [mesaId], references: [id])
  status         StatusConta @default(ABERTA)
  taxaServico    Boolean     @default(true) // o garçom desliga se o cliente não quiser pagar
  taxaPercentual Decimal     @db.Decimal(5, 2) // percentual da taxa quando a conta abriu
  cpfCnpjCliente String? // para a nota fiscal
  abertaEm       DateTime    @default(now())
  fechadaEm      DateTime?

  pedidos    Pedido[]
  pagamentos Pagamento[]
  nota       NotaFiscal?

  @@index([mesaId, status])
}

// ---------- Pagamentos ----------

model Maquineta {
  id            Int                 @id @default(autoincrement())
  nome          String // ex.: "Maquineta da Ana", "Caixa"
  operadora     OperadoraMaquineta
  integracao    IntegracaoMaquineta @default(MANUAL)
  identificador String? // número de série ou id do terminal na operadora
  garcomId      Int? // dono da maquineta (modo POR_GARCOM); null = sem dono
  garcom        Usuario?            @relation(fields: [garcomId], references: [id])
  ativa         Boolean             @default(true)
  criadaEm      DateTime            @default(now())

  pagamentos Pagamento[]
}

// Uma cobrança da conta de uma mesa. Aprovada, marca os pedidos dela como pagos.
model Pagamento {
  id                Int             @id @default(autoincrement())
  mesaId            Int
  mesa              Mesa            @relation(fields: [mesaId], references: [id])
  contaId           Int?
  conta             Conta?          @relation(fields: [contaId], references: [id])
  valor             Decimal         @db.Decimal(10, 2) // parte da conta que este pagamento quita
  gorjeta           Decimal         @default(0) @db.Decimal(10, 2) // dada além da conta
  valorServico      Decimal         @default(0) @db.Decimal(10, 2) // quanto do valor é taxa de serviço
  pix               String? // Pix copia e cola desta cobrança
  formaPagamento    String // Dinheiro, Pix, Cartão de débito, Cartão de crédito
  status            StatusPagamento @default(PENDENTE)
  maquinetaId       Int? // null = recebido sem maquineta (dinheiro, por exemplo)
  maquineta         Maquineta?      @relation(fields: [maquinetaId], references: [id])
  garcomId          Int // quem leva o crédito do recebimento (desempenho)
  garcom            Usuario         @relation(fields: [garcomId], references: [id])
  iniciadoPorId     Int // quem apertou "cobrar"
  referenciaExterna String? // número da cobrança na operadora (integração automática)
  codigoAutorizacao String? // código do comprovante
  mensagem          String? // situação para mostrar na tela
  criadoEm          DateTime        @default(now())
  concluidoEm       DateTime?

  @@index([garcomId, concluidoEm])
  @@index([contaId])
  @@index([mesaId, status])
}

// ---------- Estoque ----------

model MovimentoEstoque {
  id          Int           @id @default(autoincrement())
  produtoId   Int
  produto     Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tipo        TipoMovimento
  quantidade  Int // positivo entra, negativo sai
  saldo       Int // saldo depois do movimento
  motivo      String?
  usuarioNome String?
  criadoEm    DateTime      @default(now())

  @@index([produtoId, criadoEm])
}

// ---------- Recepção: fila de espera e reservas ----------

model Espera {
  id          Int          @id @default(autoincrement())
  nome        String
  pessoas     Int
  telefone    String?
  observacao  String?
  status      StatusEspera @default(AGUARDANDO)
  mesaId      Int? // mesa em que foi acomodado
  criadoEm    DateTime     @default(now())
  chamadoEm   DateTime?
  encerradoEm DateTime?

  @@index([status, criadoEm])
}

model Reserva {
  id         Int           @id @default(autoincrement())
  nome       String
  pessoas    Int
  telefone   String?
  dataHora   DateTime
  mesaId     Int?
  mesa       Mesa?         @relation(fields: [mesaId], references: [id])
  observacao String?
  status     StatusReserva @default(ATIVA)
  criadoEm   DateTime      @default(now())

  @@index([dataHora])
}

// ---------- Nota fiscal ----------

// Uma nota por conta fechada, emitida pelo serviço que o gestor conectou.
model NotaFiscal {
  id             Int            @id @default(autoincrement())
  contaId        Int            @unique
  conta          Conta          @relation(fields: [contaId], references: [id])
  provedor       ProvedorFiscal
  ambiente       AmbienteFiscal
  referencia     String         @unique // identificação da nota no emissor
  status         StatusNota
  numero         String?
  serie          String?
  chave          String?
  urlDanfe       String?
  urlXml         String?
  mensagem       String?
  cpfCnpjCliente String?
  valor          Decimal        @db.Decimal(10, 2)
  criadaEm       DateTime       @default(now())
  atualizadaEm   DateTime       @updatedAt

  @@index([criadaEm])
}

// ---------- Log de atividades ----------

// Um registro por atividade na plataforma. Visível só para o GESTOR.
// Não guarda corpo de requisição nem senha. Registros com mais de 90 dias são apagados.
model LogAtividade {
  id          Int      @id @default(autoincrement())
  criadoEm    DateTime @default(now())
  usuarioId   Int? // sem relação: o log sobrevive à exclusão do usuário
  usuarioNome String?
  perfil      String? // perfil no momento: GESTOR, GARCOM, COZINHA, LIMPEZA ou RECEPCAO
  tipo        String // LOGIN, FALHA_LOGIN, SAIDA, TELA, CONSULTA, CRIACAO, ALTERACAO, EXCLUSAO
  modulo      String // ex.: pedidos, mesas, cardapio, sessao
  descricao   String // frase curta em português
  metodo      String? // GET, POST, PUT, DELETE
  caminho     String? // caminho da API ou da tela, sem query string
  status      Int? // código HTTP da resposta
  duracaoMs   Int?
  ip          String?
  navegador   String?

  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
  @@index([tipo, criadoEm])
}

// ===== Configurações da plataforma (linha única, id = 1) =====

model ConfiguracaoPlataforma {
  id            Int     @id @default(1)
  nome          String  @default("Sistema de Restaurante")
  slogan        String  @default("Sabor e atendimento em cada mesa.")
  logo          String? // data URL (jpeg, png ou webp) ou endereço http(s); null = logo padrão
  corPrimaria   String  @default("#2563eb")
  corSecundaria String  @default("#1d4ed8")
  enderecoSite  String? // endereço público do site, usado nos links dos e-mails e nos QR codes

  smtpServidor       String?
  smtpPorta          Int     @default(587)
  smtpSeguro         Boolean @default(false) // true = TLS direto (porta 465)
  smtpUsuario        String?
  smtpSenhaCifrada   String? // AES-256-GCM; nunca sai pela API
  emailRemetente     String?
  emailNomeRemetente String?
  emailAtivo         Boolean @default(false)

  emailRecuperacao Boolean @default(true)
  emailBoasVindas  Boolean @default(true)

  vinculoMaquineta        VinculoMaquineta @default(COMPARTILHADA)
  mercadoPagoTokenCifrado String? // AES-256-GCM; nunca sai pela API

  // Taxa de serviço das contas novas (0 = sem taxa) e Pix do restaurante.
  taxaServicoPercentual Decimal @default(10) @db.Decimal(5, 2)
  pixChave              String?
  pixNome               String? // nome de quem recebe, como aparece no aplicativo do banco
  pixCidade             String?

  // Nota fiscal.
  fiscalProvedor            ProvedorFiscal @default(NENHUM)
  fiscalAmbiente            AmbienteFiscal @default(HOMOLOGACAO)
  fiscalCredenciaisCifradas String? // JSON com as credenciais do emissor, AES-256-GCM; nunca sai pela API
  fiscalWebhookUrl          String?
  fiscalCnpj                String?
  fiscalEmissaoAutomatica   Boolean        @default(false) // emite ao fechar a conta
  fiscalNcmPadrao           String         @default("21069090")
  fiscalCfopPadrao          String         @default("5102")
  fiscalCsosnPadrao         String         @default("102")
  fiscalClasseImposto       String? // referência da classe de imposto (WebmaniaBR)

  atualizadoEm DateTime @updatedAt
}

enum TipoTokenSenha {
  RECUPERACAO
  BOAS_VINDAS
}

// Token de uso único para criar ou redefinir a senha por e-mail (só o hash fica no banco).
model TokenSenha {
  id        Int            @id @default(autoincrement())
  usuarioId Int
  tokenHash String         @unique
  tipo      TipoTokenSenha
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime       @default(now())

  @@index([usuarioId])
}

enum StatusEmail {
  ENVIADO
  FALHOU
}

// Histórico dos e-mails enviados (sem o corpo), para o gestor conferir.
model EmailEnviado {
  id       Int         @id @default(autoincrement())
  para     String
  assunto  String
  tipo     String // TESTE, RECUPERACAO, BOAS_VINDAS
  status   StatusEmail
  erro     String?
  criadoEm DateTime    @default(now())

  @@index([criadoEm])
}
